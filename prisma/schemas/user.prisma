model User {
  id        Int      @id @default(autoincrement())
  nickname  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  tokens   Token[]
  products Product[]

  role Roles @default(USER)

  isVerified       Boolean   @default(false)
  verificationLink String    @unique @default(uuid(4))
  verifiedAt       DateTime?

  cart Cart?

  messages Message[]
  Chat     Chat[]
}
